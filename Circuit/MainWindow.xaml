<Window x:Class="Circut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impedance Converter" Height="425" Width="650" ResizeMode="NoResize" FontSize="14" WindowStartupLocation="CenterScreen" Icon="Icon.ico">
    <Grid>
        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid Width="645" HorizontalAlignment="Left">
                <TextBox x:Name="rr" HorizontalAlignment="Left" Margin="227,141,0,0" Text="1" VerticalAlignment="Top" TextAlignment="Center" MinWidth="40" MaxLines="1" MaxLength="6"/>
                <TextBox x:Name="xx" HorizontalAlignment="Left" Margin="227,221,0,0" Text="1" VerticalAlignment="Top" MinWidth="40" MaxLines="1" MaxLength="6" TextAlignment="Center"/>
                <TextBox x:Name="ff" HorizontalAlignment="Left" Margin="227,101,0,0" Text="50" VerticalAlignment="Top" TextAlignment="Center" MinWidth="40" MaxLines="1" MaxLength="6"/>
                <TextBlock x:Name="new_c" HorizontalAlignment="Left" Margin="10,0,0,20" VerticalAlignment="Bottom" Width="300" FontSize="36" TextAlignment="Center" Foreground="RoyalBlue"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run FlowDirection="RightToLeft" Text="Type"/><Run FlowDirection="RightToLeft" Text=":"/></TextBlock>
                <TextBlock HorizontalAlignment="Left" Margin="10,100,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FlowDirection="RightToLeft" Text="Frequency:"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,280,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" Text="Result"/>
                <TextBlock x:Name="textblock" HorizontalAlignment="Left" Margin="10,220,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Capacitor Value:"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,140,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Resistance:"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,180,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Impedance Type:"/>
                <Grid HorizontalAlignment="Left" Margin="150,61,0,0" VerticalAlignment="Top">
                    <RadioButton x:Name="t_h" Content="Parallel to series" HorizontalAlignment="Left" Margin="175,0,0,0" VerticalAlignment="Top"/>
                    <RadioButton Content="Series to parallel" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="True"/>
                </Grid>
                <Grid HorizontalAlignment="Left" Margin="150,181,0,0" VerticalAlignment="Top">
                    <RadioButton x:Name="is_l" Content="Inductor" HorizontalAlignment="Left" Margin="175,0,-17,0" VerticalAlignment="Top" Checked="RadioButton_Checked_1"/>
                    <RadioButton Content="Capacitor" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="True" Checked="RadioButton_Checked"/>
                </Grid>
                <ComboBox x:Name="r_u" HorizontalAlignment="Left" Margin="150,139,0,0" VerticalAlignment="Top" Width="60" SelectedIndex="1" FlowDirection="LeftToRight">
                    <ComboBoxItem Content="Ω"/>
                    <ComboBoxItem Content="KΩ"/>
                    <ComboBoxItem Content="MΩ"/>
                    <ComboBoxItem Content="GΩ"/>
                </ComboBox>
                <ComboBox x:Name="f_u" HorizontalAlignment="Left" Margin="150,99,0,0" VerticalAlignment="Top" Width="60" SelectedIndex="0" FlowDirection="LeftToRight">
                    <ComboBoxItem Content="Hz"/>
                    <ComboBoxItem Content="KHz"/>
                    <ComboBoxItem Content="MHz"/>
                    <ComboBoxItem Content="GHz"/>
                </ComboBox>
                <ComboBox x:Name="c_u" HorizontalAlignment="Left" Margin="150,219,0,0" VerticalAlignment="Top" Width="60" FlowDirection="LeftToRight" SelectedIndex="2" RenderTransformOrigin="0.5,0.5">
                    <ComboBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="1" ScaleX="1"/>
                            <SkewTransform AngleY="0" AngleX="0"/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </ComboBox.RenderTransform>
                    <ComboBoxItem Content="F"/>
                    <ComboBoxItem Content="mF"/>
                    <ComboBoxItem Content="μF"/>
                    <ComboBoxItem Content="nF"/>
                </ComboBox>
                <TextBlock x:Name="new_r" HorizontalAlignment="Right" Margin="0,0,10,20" TextWrapping="Wrap" VerticalAlignment="Bottom" Width="300" FontSize="36" TextAlignment="Center" Foreground="RoyalBlue"/>
                <Rectangle Height="3" Margin="75,270,75,0" VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                    <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF88A3DE" Offset="0"/>
                            <GradientStop Color="White" Offset="1"/>
                            <GradientStop Color="#FFA2B7E5" Offset="0.177"/>
                            <GradientStop Color="#FEAEC0E8" Offset="0.373"/>
                            <GradientStop Color="#FEC6D2EE" Offset="0.53"/>
                            <GradientStop Color="#FEDBE2F4" Offset="0.711"/>
                            <GradientStop Color="#FEE5EAF7" Offset="0.795"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Button x:Name="convert" Content="Convert" HorizontalAlignment="Right" Margin="0,233,75,0" VerticalAlignment="Top" Width="90" BorderBrush="#FF17630F" Foreground="#FF17630F" Height="30" IsDefault="True" Click="Convert_Click" Background="#00DDDDDD"/>
            </Grid>
            <Grid Margin="650,0,0,0" Width="645" HorizontalAlignment="Left">
                <Image HorizontalAlignment="Right" Margin="0,110,25,0" VerticalAlignment="Top" Stretch="Fill" Source="1.png" Height="65" Width="250"/>
                <Image HorizontalAlignment="Left" Margin="35,110,0,0" VerticalAlignment="Top" Stretch="Fill" Source="2.png" Height="65" Width="250"/>
                <Image HorizontalAlignment="Left" Margin="25,0,0,25" VerticalAlignment="Bottom" Stretch="Fill" Source="3.png" Height="100" Width="230"/>
                <Image HorizontalAlignment="Right" Margin="0,0,25,25" VerticalAlignment="Bottom" Stretch="Fill" Source="4.png" Height="100" Width="230"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,50,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Text="1- Series to parallel:"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,210,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Text="2- Parallel to series:"/>
                <Rectangle Height="3" Margin="81,195,69,0" VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                    <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FFB2C30A" Offset="0"/>
                            <GradientStop Color="White" Offset="1"/>
                            <GradientStop Color="#FFE0E79F" Offset="0.482"/>
                            <GradientStop Color="#FFD5DE7D" Offset="0.233"/>
                            <GradientStop Color="#FFE8EDB9" Offset="0.594"/>
                            <GradientStop Color="#FFEEF2CD" Offset="0.707"/>
                            <GradientStop Color="#FFF3F5DB" Offset="0.867"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Grid>
        <StackPanel Height="45" VerticalAlignment="Top" Orientation="Horizontal" Background="Black">
            <Label x:Name="label1" Content="Convert" FontSize="24" Background="White" MouseUp="Label1_MouseUp" Cursor="Hand"/>
            <Label x:Name="label2" Content="Conversion Lows" FontSize="24" Foreground="White" Background="Black" MouseUp="label2_MouseUp" Cursor="Hand"/>
        </StackPanel>
        <Rectangle x:Name="rec" Fill="Red" HorizontalAlignment="Left" Height="4" Margin="0,41,0,0" VerticalAlignment="Top" Width="93"/>
        <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap" Text="by: Dr.Mohammad" VerticalAlignment="Top" Foreground="#FF0D0D0D"/>
        <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap" Text="Dr.Mohammad@outlook.com" VerticalAlignment="Top" Foreground="#FF0D0D0D" Margin="0,19,0,0"/>
    </Grid>
</Window>
